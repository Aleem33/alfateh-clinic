rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('deleted', false) != true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', true) != false
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in
          ['admin', 'doctor', 'nurse', 'receptionist', 'pharmacist', 'cashier', 'accountant', 'lab', 'lab_technician'];
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return isAuth()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userRole() in roles;
    }

    function isAdmin()      { return hasRole(['admin']); }
    match /labReports/{orderId}/{fileName} {
      allow read: if isAuth();
      allow create, update: if hasRole(['admin', 'doctor', 'nurse', 'lab', 'lab_technician'])
        && request.resource.size <= 12 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
